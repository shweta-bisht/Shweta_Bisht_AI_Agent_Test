# ==========================================
# CommerceAI Configuration (.env.example)
# Copy this file to .env and fill in your API keys.
# Never commit .env or real API keys to version control.
# ==========================================

# --- Mandatory for Content & Image Generation (unless --dry-run) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Optional: Search API for Competitor Analysis ---
# Supported providers: serper, tavily, serpapi, google_cse
SEARCH_PROVIDER=serper
SEARCH_API_KEY=
# Required only when SEARCH_PROVIDER=google_cse
SEARCH_CSE_ID=

# --- Input / Output Paths ---
INPUT_FILE=test data.xlsx
OUTPUT_DIR=outputs
IMAGE_DIR=images
LOG_DIR=logs

# --- Execution & Rate Limiting ---
MAX_RETRIES=3
MAX_CONCURRENT_REQUESTS=3
REQUEST_TIMEOUT=120
COMPETITOR_PRODUCT_COUNT=5
CACHE_ENABLED=true

# --- Sales Status Rules (comma-separated) ---
SALES_CONFIRMED_STATUSES=Processed
SALES_EXCLUDED_STATUSES=Cancelled,Pending
SALES_SEPARATE_STATUSES=OJ Shipping

# --- Logging ---
LOG_LEVEL=INFO
